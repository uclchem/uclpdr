# Sundials 2.5.0 - Ignore build artifacts, keep source

# Compiled object files
*.o
*.lo
*.obj

# Compiled libraries
*.a
*.la
*.so
*.so.*
*.dylib
*.lib
*.dll

# Libtool files
.libs/
.deps/
*.lo
libtool

# Autotools generated files
config.h
config.log
config.status
stamp-h1
autom4te.cache/

# Makefiles generated by configure
Makefile
!Makefile.in
src/*/Makefile
src/*/*/Makefile
examples/*/Makefile
examples/*/*/Makefile
sundialsTB/*/Makefile

# Build directories
build/
# bin/
lib/

# Example executables and outputs
examples/**/cvs*
examples/**/ids*
examples/**/kin*
examples/**/*.out
examples/**/*.txt
examples/**/*_out

# Documentation builds (if generated)
doc/html/
doc/latex/
*.pdf
!doc/**/*.pdf

# Editor and IDE files
*.swp
*~
.DS_Store
*.bak
.vscode/
.idea/

# CMake (if used)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
